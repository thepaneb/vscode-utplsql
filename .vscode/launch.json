{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Executar a extensão",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "port": 9339,
      "timeout": 60000,
      "outFiles": [
        "${workspaceFolder}/out/**/*.js",
        "${workspaceFolder}/dist/**/*.js"
      ],
      "experimentalNetworking": "off",
      "preLaunchTask": "extension: build"
    },
    {
      "name": "Anexar ao Extension Host (9339)",
      "type": "node",
      "request": "attach",
      "port": 9339,
      "restart": true,
      "outFiles": [
        "${workspaceFolder}/out/**/*.js",
        "${workspaceFolder}/dist/**/*.js"
      ],
      "resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"],
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Testes unitários",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--require",
        "${workspaceFolder}/scripts/test-setup.cjs",
        "--test",
        "${workspaceFolder}/out/test/unit/*.test.js"
      ],
      "preLaunchTask": "npm: compile",
      "outFiles": ["${workspaceFolder}/out/**/*.js"]
    }
  ]
}
