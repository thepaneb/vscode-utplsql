FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates xvfb xdotool scrot openbox librsvg2-bin unzip libgtk-3-0 libnss3 libxss1 libxtst6 libasound2t64 libgbm1 libdrm2 libxkbcommon0 && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - && apt-get install -y nodejs && rm -rf /var/lib/apt/lists/*

ARG VSCODE_VER=1.88.1
RUN curl -fsSL "https://update.code.visualstudio.com/${VSCODE_VER}/linux-x64/stable" -o /tmp/vscode.tar.gz && mkdir -p /opt/vscode && tar xzf /tmp/vscode.tar.gz -C /opt/vscode --strip-components=1 && rm /tmp/vscode.tar.gz

# utPLSQL CLI (Java client)
RUN curl -fsSL "https://github.com/utPLSQL/utPLSQL-cli/releases/download/v3.2.0/utplsql-cli.zip" -o /tmp/cli.zip \
    && mkdir -p /opt/utplsql-cli \
    && unzip -q /tmp/cli.zip -d /opt/utplsql-cli \
    && rm /tmp/cli.zip \
    && chmod +x /opt/utplsql-cli/utPLSQL-cli/bin/utplsql

# Java (needed by utPLSQL-cli)
RUN apt-get update && apt-get install -y --no-install-recommends default-jre-headless && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY scripts/gen-screenshots-container.sh /usr/local/bin/gen-screenshots
RUN chmod +x /usr/local/bin/gen-screenshots

ENTRYPOINT ["/usr/local/bin/gen-screenshots"]
