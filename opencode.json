{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "obsidian": {
        "type": "local",
        "command": ["python3", "scripts/obsidian-mcp.py"]
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_TOKEN}"
        }
      }
    }
  }
}
