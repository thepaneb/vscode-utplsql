{
  "name": "vscode-utplsql",
  "displayName": "utPLSQL Test Runner",
  "description": "Roda testes utPLSQL pelo Test Explorer do VSCode, com menu de contexto e cobertura visual (estilo pytest).",
  "version": "0.12.0",
  "publisher": "paneb",
  "author": "Gil Cleber Barboza",
  "license": "MIT",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.88.0",
    "node": ">=22.0.0"
  },
  "categories": [
    "Testing"
  ],
  "keywords": [
    "utplsql",
    "plsql",
    "oracle",
    "test",
    "coverage"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/thepaneb/vscode-utplsql.git"
  },
  "bugs": {
    "url": "https://github.com/thepaneb/vscode-utplsql/issues"
  },
  "homepage": "https://github.com/thepaneb/vscode-utplsql#readme",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "activationEvents": [
    "workspaceContains:**/*.pks",
    "workspaceContains:**/*.pkb"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "utPLSQL",
      "properties": {
        "utplsql.profiles": {
          "type": "array",
          "default": [],
          "markdownDescription": "Perfis de conexão Oracle salvos para alternar rapidamente entre ambientes (DEV, TEST, PROD). Cada perfil pode sobrescrever `connection`, `sourcePath`, `coverageOwner`, etc. **A senha fica em texto plano nas settings** — prefira `env`/`UTPLSQL_CONN` para produção.",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "connection": {
                "type": "string"
              },
              "description": {
                "type": "string",
                "description": "Descrição amigável exibida no picker de conexão."
              },
              "charset": {
                "type": "string",
                "enum": [
                  "utf8",
                  "latin1",
                  "win1252"
                ],
                "default": "utf8",
                "description": "Encoding para ler arquivos de script (runScriptFile/runScriptFolder). Omitido = utf8."
              },
              "sourcePath": {
                "type": "string"
              },
              "coverageOwner": {
                "type": "string"
              },
              "includePatterns": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "isDefault": {
                "type": "boolean"
              },
              "lastUsed": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "connection"
            ]
          }
        },
        "utplsql.activeProfile": {
          "type": "string",
          "default": "",
          "markdownDescription": "ID do perfil de conexão ativo (`utplsql.profiles`). Quando definido, sobrescreve `utplsql.connection`."
        },
        "utplsql.connection": {
          "type": "string",
          "default": "",
          "markdownDescription": "String de conexão Oracle (`usuario/senha@//host:porta/servico`). Se vazio, usa a variável de ambiente `UTPLSQL_CONN`; se ainda assim vazio, a extensão pergunta (e mantém só na sessão). **Recomendado deixar vazio e usar a variável de ambiente** para não gravar a senha nas settings."
        },
        "utplsql.sourcePath": {
          "type": "string",
          "default": "install",
          "description": "Pasta (relativa à raiz do workspace) com o código de produção. Usada no parâmetro -source_path para mapear a cobertura aos arquivos locais."
        },
        "utplsql.includePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*.pks"
          ],
          "description": "Globs para descobrir os specs de teste que contêm as annotations %suite/%test."
        },
        "utplsql.coverageOwner": {
          "type": "string",
          "default": "",
          "description": "Schema dono dos objetos para o mapeamento de cobertura. Se vazio, usa o usuário da conexão (parte antes de '/'), em maiúsculas."
        },
        "utplsql.timeoutMinutes": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "maximum": 1440,
          "description": "Timeout em minutos para o utPLSQL-cli (flag -t)."
        },
        "utplsql.dbmsOutput": {
          "type": "boolean",
          "default": false,
          "description": "Habilita DBMS_OUTPUT na sessão de teste (flag -D). Útil para debugar."
        },
        "utplsql.additionalReporters": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Reporters adicionais para incluir em toda execução (ex.: [\"ut_coverage_html_reporter\"]). Os reporters padrão (documentation, junit e cobertura) são sempre incluídos."
        },
        "utplsql.oraclePoolMin": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "description": "Conexões mínimas mantidas no pool do Oracle runner (node-oracledb)."
        },
        "utplsql.oraclePoolMax": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "Conexões máximas no pool do Oracle runner (node-oracledb)."
        },
        "utplsql.oraclePoolIncrement": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "description": "Incremento ao expandir o pool do Oracle runner (node-oracledb)."
        },
        "utplsql.oraclePoolPingInterval": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "description": "Segundos entre health checks das conexões ociosas do pool (node-oracledb). 0 = ping a cada checkout."
        },
        "utplsql.organization": {
          "type": "string",
          "enum": [
            "file",
            "schema"
          ],
          "default": "file",
          "enumDescriptions": [
            "Organiza os testes por caminho de arquivo (padrão).",
            "Organiza os testes por schema Oracle (Schema > Package > Suite > Test). Use organization.schemaPattern para definir como extrair o schema do caminho."
          ],
          "description": "Modo de organização da árvore de testes no Test Explorer."
        },
        "utplsql.organization.schemaPattern": {
          "type": "string",
          "default": "db/{schema}/**",
          "markdownDescription": "Padrão glob para extrair o nome do schema a partir do caminho do arquivo. Use `{schema}` como placeholder. Ex: `db/{schema}/**` extrai `APP` de `db/APP/tests/ut_foo.pks`. Só usado quando `#utplsql.organization#` é `schema`."
        },
        "utplsql.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Exibe botões CodeLens Run/Run with Coverage sobre %suite e %test."
        },
        "utplsql.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Exibe indicador de status dos testes na barra de status."
        },
        "utplsql.decorations.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Exibe decorações de pass/fail nas linhas %suite e %test após execução."
        },
        "utplsql.compilationDiagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Exibe erros de compilação PL/SQL como sublinhados no editor e no Problems Panel após execução dos testes."
        },
        "utplsql.setupDiagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Exibe diagnósticos de configuração (CLI, conexão, grants, versão) no Problems Panel e oferece quick-fix actions."
        },
        "utplsql.sqlCoverageEnabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Habilita rastreio de views via `V$SQL` (cobertura booleana: executada = 100%, não executada = 0%). Requer `GRANT SELECT ON V$SQL` no Oracle. Views já aparecem no relatório com 0 hits via `type_mapping` mesmo desligado."
        },
        "utplsql.debugger.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Habilita o suporte a debug de testes PL/SQL (DBMS_DEBUG). Requer node-oracledb e grants."
        },
        "utplsql.debugger.stopOnException": {
          "type": "boolean",
          "default": true,
          "description": "Pausa automaticamente em exceções PL/SQL durante o debug."
        },
        "utplsql.debugger.timeoutSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 30,
          "description": "Timeout (s) da sessão de debug para evitar conexões Oracle zumbis."
        },
        "utplsql.scriptRunner.stopOnError": {
          "type": "boolean",
          "default": true,
          "description": "Para a execução do script na primeira falha (false = continua registrando as demais)."
        },
        "utplsql.scriptRunner.autoCommit": {
          "type": "boolean",
          "default": true,
          "description": "autoCommit em cada statement do script."
        },
        "utplsql.scriptRunner.filePattern": {
          "type": "string",
          "default": "**/*.{sql,pks,pkb,fnc,prc,trg}",
          "description": "Globs para listar arquivos na execução de pasta de scripts."
        },
        "utplsql.scriptRunner.dbmsOutput": {
          "type": "boolean",
          "default": false,
          "description": "Captura e exibe DBMS_OUTPUT durante a execução do script."
        },
        "utplsql.scriptRunner.timeoutSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 30,
          "description": "Timeout (s) por statement do script (callTimeout)."
        },
        "utplsql.language": {
          "type": "string",
          "enum": [
            "auto",
            "pt-br",
            "en",
            "en-gb",
            "es",
            "zh-cn",
            "zh-tw",
            "ja",
            "de",
            "fr",
            "it",
            "ko",
            "ru",
            "tr",
            "pl",
            "cs",
            "hu",
            "bg",
            "el",
            "id",
            "ro",
            "sr",
            "th",
            "uk",
            "vi"
          ],
          "default": "auto",
          "markdownDescription": "Idioma dos conteúdos textuais da extensão. `auto` segue o idioma do VSCode (15 nativos + bg, el, en-gb, id, ro, sr, th, uk, vi; senão en)."
        }
      }
    },
    "commands": [
      {
        "command": "utplsql.showTestExplorer",
        "title": "%nls.command.showTestExplorer%",
        "category": "utPLSQL"
      },
      {
        "command": "utplsql.runLens",
        "title": "%nls.command.runLens%",
        "category": "utPLSQL"
      },
      {
        "command": "utplsql.refresh",
        "title": "%nls.command.refresh%",
        "category": "utPLSQL",
        "icon": "$(refresh)"
      },
      {
        "command": "utplsql.runAll",
        "title": "%nls.command.runAll%",
        "category": "utPLSQL"
      },
      {
        "command": "utplsql.runFile",
        "title": "%nls.command.runFile%",
        "category": "utPLSQL"
      },
      {
        "command": "utplsql.runFileCoverage",
        "title": "%nls.command.runFileCoverage%",
        "category": "utPLSQL"
      },
      {
        "command": "utplsql.runFolder",
        "title": "%nls.command.runFolder%",
        "category": "utPLSQL"
      },
      {
        "command": "utplsql.runFolderCoverage",
        "title": "%nls.command.runFolderCoverage%",
        "category": "utPLSQL"
      },
      {
        "command": "utplsql.cancelRun",
        "title": "%nls.command.cancelRun%",
        "category": "utPLSQL"
      },
      {
        "command": "utplsql.clearConnection",
        "title": "%nls.command.clearConnection%",
        "category": "utPLSQL"
      },
      {
        "command": "utplsql.showInfo",
        "title": "%nls.command.showInfo%",
        "category": "utPLSQL"
      },
      {
        "command": "utplsql.selectReporter",
        "title": "%nls.command.selectReporter%",
        "category": "utPLSQL"
      },
      {
        "command": "utplsql.rerunLast",
        "title": "%nls.command.rerunLast%",
        "category": "utPLSQL"
      },
      {
        "command": "utplsql.runAtCursor",
        "title": "%nls.command.runAtCursor%",
        "category": "utPLSQL"
      },
      {
        "command": "utplsql.runFailed",
        "title": "%nls.command.runFailed%",
        "category": "utPLSQL"
      },
      {
        "command": "utplsql.configureConnection",
        "title": "%nls.command.configureConnection%",
        "category": "utPLSQL"
      },
      {
        "command": "utplsql.copyGrantsToClipboard",
        "title": "%nls.command.copyGrantsToClipboard%",
        "category": "utPLSQL"
      },
      {
        "command": "utplsql.validateSetup",
        "title": "%nls.command.validateSetup%",
        "category": "utPLSQL"
      },
      {
        "command": "utplsql.switchProfile",
        "title": "%nls.command.switchProfile%",
        "category": "utPLSQL"
      },
      {
        "command": "utplsql.newProfile",
        "title": "%nls.command.newProfile%",
        "category": "utPLSQL"
      },
      {
        "command": "utplsql.manageProfiles",
        "title": "%nls.command.manageProfiles%",
        "category": "utPLSQL"
      },
      {
        "command": "utplsql.importSqlDevConnections",
        "title": "%nls.command.importSqlDevConnections%",
        "category": "utPLSQL"
      },
      {
        "command": "utplsql.debugTest",
        "title": "%nls.command.debugTest%",
        "category": "utPLSQL"
      },
      {
        "command": "utplsql.runScript",
        "title": "%nls.command.runScript%",
        "category": "utPLSQL"
      },
      {
        "command": "utplsql.runScriptFile",
        "title": "%nls.command.runScriptFile%",
        "category": "utPLSQL"
      },
      {
        "command": "utplsql.runScriptFolder",
        "title": "%nls.command.runScriptFolder%",
        "category": "utPLSQL"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "utplsql.runFile",
          "group": "utplsql@1",
          "when": "resourceExtname == .pks || resourceExtname == .pkb"
        },
        {
          "command": "utplsql.runFileCoverage",
          "group": "utplsql@2",
          "when": "resourceExtname == .pks || resourceExtname == .pkb"
        },
        {
          "command": "utplsql.runScriptFile",
          "group": "utplsql@3",
          "when": "resourceExtname == .sql || resourceExtname == .pks || resourceExtname == .pkb || resourceExtname == .fnc || resourceExtname == .prc || resourceExtname == .trg"
        },
        {
          "command": "utplsql.runScriptFolder",
          "group": "utplsql@3",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "utplsql.runFolder",
          "group": "utplsql@1",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "utplsql.runFolderCoverage",
          "group": "utplsql@2",
          "when": "explorerResourceIsFolder"
        }
      ],
      "editor/context": [
        {
          "command": "utplsql.runFile",
          "group": "utplsql@1",
          "when": "resourceExtname == .pks || resourceExtname == .pkb"
        },
        {
          "command": "utplsql.runFileCoverage",
          "group": "utplsql@2",
          "when": "resourceExtname == .pks || resourceExtname == .pkb"
        },
        {
          "command": "utplsql.runScript",
          "group": "utplsql@3",
          "when": "resourceExtname == .sql || resourceExtname == .pks || resourceExtname == .pkb || resourceExtname == .fnc || resourceExtname == .prc || resourceExtname == .trg"
        }
      ]
    },
    "keybindings": [
      {
        "command": "utplsql.runAll",
        "key": "ctrl+shift+u r",
        "mac": "cmd+shift+u r",
        "when": "utplsql:connected"
      },
      {
        "command": "utplsql.refresh",
        "key": "ctrl+shift+u f",
        "mac": "cmd+shift+u f",
        "when": "utplsql:activated"
      },
      {
        "command": "utplsql.cancelRun",
        "key": "escape",
        "when": "utplsql:running"
      },
      {
        "command": "utplsql.showInfo",
        "key": "ctrl+shift+u i",
        "mac": "cmd+shift+u i",
        "when": "utplsql:activated"
      },
      {
        "command": "utplsql.clearConnection",
        "key": "ctrl+shift+u c",
        "mac": "cmd+shift+u c",
        "when": "utplsql:activated"
      },
      {
        "command": "utplsql.runFile",
        "key": "ctrl+shift+u t",
        "mac": "cmd+shift+u t",
        "when": "editorTextFocus && resourceExtname =~ /\\.pks|\\\\.pkb/ && utplsql:connected"
      },
      {
        "command": "utplsql.runFileCoverage",
        "key": "ctrl+shift+u shift+t",
        "mac": "cmd+shift+u shift+t",
        "when": "editorTextFocus && resourceExtname =~ /\\.pks|\\\\.pkb/ && utplsql:connected"
      },
      {
        "command": "utplsql.rerunLast",
        "key": "ctrl+shift+u l",
        "mac": "cmd+shift+u l",
        "when": "utplsql:activated"
      },
      {
        "command": "utplsql.runAtCursor",
        "key": "ctrl+shift+u u",
        "mac": "cmd+shift+u u",
        "when": "editorTextFocus && resourceExtname == .pks"
      },
      {
        "command": "utplsql.runFailed",
        "key": "ctrl+shift+u x",
        "mac": "cmd+shift+u x",
        "when": "utplsql:hasFailures"
      }
    ]
  },
  "debuggers": [
    {
      "type": "utplsql",
      "label": "utPLSQL Debugger",
      "configurationAttributes": {
        "launch": {
          "properties": {
            "packageName": {
              "type": "string",
              "description": "Test package to debug"
            },
            "testName": {
              "type": "string",
              "description": "Specific test procedure"
            },
            "connection": {
              "type": "string",
              "description": "Oracle connection string"
            },
            "stopOnException": {
              "type": "boolean",
              "default": true
            }
          }
        }
      }
    }
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run bundle",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "pretest:unit": "npm run compile && npm run lint",
    "test:unit": "node scripts/run-tests.cjs",
    "pretest:integration": "npm run compile && npm run bundle",
    "test:integration": "vscode-test",
    "test": "npm run test:unit",
    "test:coverage": "npm run compile && c8 node --experimental-test-module-mocks --require ./scripts/test-setup.cjs --test out/test/unit/**/*.test.js",
    "bundle": "node esbuild.config.mjs",
    "package": "npm run compile && npm run bundle && vsce package",
    "gen-icon": "node scripts/gen-icon.cjs",
    "gen-diagram": "node scripts/gen-diagrams.cjs",
    "sync-prds": "node scripts/sync-prds.cjs",
    "publish": "node scripts/publish.cjs",
    "publish:patch": "echo '⚠️ Publicacao apenas via GitHub workflow (release). Use npm run package para .vsix local.' && exit 1"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "oracledb": "^7.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@resvg/resvg-js": "^2.6.2",
    "@types/mocha": "^10.0.7",
    "@types/node": "^22.20.1",
    "@types/oracledb": "^7.0.2",
    "@types/vscode": "^1.88.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.1",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "diff": "8.0.3",
    "serialize-javascript": "7.0.5"
  }
}
